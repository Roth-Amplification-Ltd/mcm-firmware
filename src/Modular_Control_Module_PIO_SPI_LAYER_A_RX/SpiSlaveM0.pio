.program spi_slave_m0_msb_rx

; =============================================================================
; HISTORICAL SPI PIO COPY — REFERENCE ONLY
; =============================================================================
; This file preserves the nested source tree's original program behavior and
; comments, but the corrected root `src/SpiSlaveM0.pio` is authoritative.
;
; The root copy uses absolute WAIT GPIO syntax and a configured JMP PIN. This
; historical copy uses PIN operands as originally checked in and must not be
; selected for production hardware work without correcting/revalidating it.
;
; Intended pins:
;   GPIO12 SCK, GPIO13 CS, GPIO14 MISO, GPIO15 MOSI
; Intended mode:
;   SPI Mode 0, MSB-first
; =============================================================================

.wrap_target

wait_cs_low:
    wait 0 pin 13
    wait 0 pin 12

byte_loop:
    pull noblock
    out  pins, 1
    mov  isr, null
    set x, 7

bit_loop:
    wait 1 pin 12
    in   pins, 1
    wait 0 pin 12
    out  pins, 1
    jmp  x-- bit_loop

    push block
    jmp  pin 13 wait_cs_low
    jmp  byte_loop

.wrap
