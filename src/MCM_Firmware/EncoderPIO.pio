.program encoder_state_stream

; Push one two-bit A/B state whenever either phase changes. The C++ decoder owns
; direction validation and count saturation. PUSH BLOCK provides hardware
; backpressure if the CPU temporarily falls behind.

.wrap_target
    mov isr, null
    in  pins, 2
    mov x, isr
sample:
    mov isr, null
    in  pins, 2
    mov y, isr
    jmp x!=y changed
    jmp sample
changed:
    mov x, y
    mov isr, y
    push block
    jmp sample
.wrap
