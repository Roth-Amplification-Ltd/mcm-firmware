.program spi_slave_m0_msb_rx

; SPI Mode 0, MSB-first peripheral transport.
; External GPIO assignments are fixed by the MCM KiCad design:
;   GPIO12 SCK, GPIO13 CS, GPIO14 MISO, GPIO15 MOSI.
;
; WAIT GPIO uses absolute GPIO numbers. JMP PIN uses the state machine's
; configured jump pin, which TransportSPI::begin() sets to GPIO13 / SPI_CS.

.wrap_target
wait_cs_low:
    wait 0 gpio 13             ; CS asserted
    wait 0 gpio 12             ; Mode 0 idle clock state

byte_loop:
    pull noblock
    out  pins, 1               ; present first MISO bit before rising edge
    mov  isr, null
    set  x, 7

bit_loop:
    wait 1 gpio 12             ; sample MOSI on rising edge
    in   pins, 1
    wait 0 gpio 12             ; update MISO on falling edge
    out  pins, 1
    jmp  x-- bit_loop

    push block
    jmp  pin wait_cs_low       ; configured jump pin is SPI_CS
    jmp  byte_loop
.wrap
